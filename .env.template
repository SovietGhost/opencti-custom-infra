# Source of truth for .env — rendered by scripts/generate-env.sh
# Directives: @uuid | @hex32 | @pass | @base64 | (empty = placeholder) | literal

###########################
# COMPOSE                 #
###########################
COMPOSE_PROJECT_NAME=opencti
# Which connector groups start. "connectors" = every connector below.
# Or pick individually: alienvault,malpedia,mandiant,cisa-kev,threatfox,urlhaus,
# abuseipdb-blacklist,virustotal,shodan,abuseipdb
COMPOSE_PROFILES=

###########################
# DEPENDENCIES            #
###########################
MINIO_ROOT_USER=opencti
MINIO_ROOT_PASSWORD=@pass
RABBITMQ_DEFAULT_USER=opencti
RABBITMQ_DEFAULT_PASS=@pass
SMTP_HOSTNAME=localhost
OPENSEARCH_ADMIN_PASSWORD=@pass
ELASTIC_MEMORY_SIZE=4G

###########################
# COMMON                  #
###########################
XTM_COMPOSER_ID=@uuid
PLATFORM_REGISTRATION_TOKEN=@hex32

###########################
# OPENCTI                 #
###########################
OPENCTI_HOST=localhost
OPENCTI_PORT=8080
OPENCTI_EXTERNAL_SCHEME=http
OPENCTI_ADMIN_EMAIL=admin@opencti.local
OPENCTI_ADMIN_PASSWORD=@pass
OPENCTI_ADMIN_TOKEN=@uuid
OPENCTI_HEALTHCHECK_ACCESS_KEY=@hex32
OPENCTI_ENCRYPTION_KEY=@base64

###########################
# XTM ONE                 #
###########################
XTM_ONE_HOST=localhost
XTM_ONE_PORT=8090
XTM_ONE_EXTERNAL_SCHEME=http
XTM_ONE_ADMIN_EMAIL=admin@opencti.local
XTM_ONE_ADMIN_PASSWORD=@pass
XTM_ONE_SECRET_KEY=@hex32
XTM_ONE_POSTGRES_USER=xtmone
XTM_ONE_POSTGRES_PASSWORD=@pass
XTM_ONE_S3_BUCKET=xtm-one-files
XTM_ONE_ENTERPRISE_LICENSE=
XTM_ONE_LOG_LEVEL=info
XTM_ONE_LOG_FORMAT=json

###########################
# UPSTREAM CONNECTORS     #
# (defined in opencti/docker-compose.yml)
###########################
CONNECTOR_EXPORT_FILE_STIX_ID=@uuid
CONNECTOR_EXPORT_FILE_CSV_ID=@uuid
CONNECTOR_EXPORT_FILE_TXT_ID=@uuid
CONNECTOR_IMPORT_FILE_STIX_ID=@uuid
CONNECTOR_IMPORT_DOCUMENT_ID=@uuid
CONNECTOR_IMPORT_FILE_YARA_ID=@uuid
CONNECTOR_IMPORT_EXTERNAL_REFERENCE_ID=@uuid
CONNECTOR_ANALYSIS_ID=@uuid
CONNECTOR_OPENCTI_ID=@uuid
CONNECTOR_MITRE_ID=@uuid

###########################
# EXTERNAL-IMPORT         #
###########################
# AlienVault OTX — https://otx.alienvault.com/settings
CONNECTOR_ALIENVAULT_ID=@uuid
ALIENVAULT_API_KEY=

# Malpedia — key optional, unlocks full dataset (https://malpedia.caad.fkie.fraunhofer.de)
CONNECTOR_MALPEDIA_ID=@uuid
MALPEDIA_AUTH_KEY=

# Mandiant (Google Threat Intelligence v4 API key pair)
CONNECTOR_MANDIANT_ID=@uuid
MANDIANT_API_V4_KEY_ID=
MANDIANT_API_V4_KEY_SECRET=

# CISA Known Exploited Vulnerabilities — no key
CONNECTOR_CISA_KEV_ID=@uuid

# abuse.ch ThreatFox / URLhaus — no key
CONNECTOR_THREATFOX_ID=@uuid
CONNECTOR_URLHAUS_ID=@uuid

# AbuseIPDB IP blacklist (shares ABUSEIPDB_API_KEY with the enrichment connector)
CONNECTOR_ABUSEIPDB_BLACKLIST_ID=@uuid
ABUSEIPDB_BLACKLIST_SCORE=90

###########################
# INTERNAL-ENRICHMENT     #
###########################
CONNECTOR_VIRUSTOTAL_ID=@uuid
VIRUSTOTAL_TOKEN=

CONNECTOR_SHODAN_ID=@uuid
SHODAN_TOKEN=

CONNECTOR_ABUSEIPDB_ID=@uuid
ABUSEIPDB_API_KEY=
